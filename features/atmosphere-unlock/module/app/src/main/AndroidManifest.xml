<?xml version="1.0" encoding="utf-8"?>
<!-- Xposed-module meta-data per setup.md §4.3 (xposedscope = spec §8.2).
     xposed_init / yukihookapi_init are GENERATED by the KSP processor — never hand-write them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selection-surface gate (spec §8.8): the Atmosphere screen writes its
         Settings.System keys only through the stock WRITE_SETTINGS special grant. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_atmosphere"
        android:label="@string/app_label">

        <!-- Set as Xposed module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Nothing Atmosphere unlock effect — Evolution X (Pong)" />
        <!-- Minimum Xposed API (the 1.x docs recommend 93 for LSPosed-family managers) -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- Pre-select the SystemUI scope (spec §8.2) -->
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui" />

        <!-- Selection surface (spec §8.8): launcher entry plus the standard
             wallpaper-hub listing — the EvoX Settings hub and the fork picker
             both enumerate ACTION_SET_WALLPAPER activities via queryIntentActivities. -->
        <activity
            android:name=".AtmosphereActivity"
            android:exported="true"
            android:label="@string/atmosphere_screen_label"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
